{
  "name": "proper-compact",
  "version": "0.3.0",
  "description": "Evidence-preserving Pi compaction with bounded summaries and transcript recall",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "compaction"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharaf-nassar/proper-pi-extensions.git",
    "directory": "proper-compact"
  },
  "homepage": "https://github.com/sharaf-nassar/proper-pi-extensions/tree/main/proper-compact#readme",
  "bugs": {
    "url": "https://github.com/sharaf-nassar/proper-pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "compact.ts",
    "context.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm test && npm run typecheck",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test --test-coverage-lines=75 --test-coverage-branches=70 --test-coverage-functions=75 test/*.test.ts",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.1",
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "25.9.5",
    "typebox": "^1.3.7",
    "typescript": "6.0.2"
  },
  "pi": {
    "extensions": [
      "./compact.ts"
    ]
  }
}
