{
  "name": "proper-model-prompts",
  "version": "0.1.0",
  "description": "Per-model system prompt text for Pi, with built-in prompts for Claude and GPT models",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "system-prompt",
    "models"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharaf-nassar/proper-pi-extensions.git",
    "directory": "proper-model-prompts"
  },
  "homepage": "https://github.com/sharaf-nassar/proper-pi-extensions/tree/main/proper-model-prompts#readme",
  "bugs": {
    "url": "https://github.com/sharaf-nassar/proper-pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "model-prompts.ts",
    "defaults.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm test && npm run typecheck",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test --test-coverage-lines=75 --test-coverage-branches=70 --test-coverage-functions=75 test/*.test.ts",
    "test:subagents": "node test/subagents-smoke.mjs",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "25.9.5",
    "typescript": "6.0.2"
  },
  "pi": {
    "extensions": [
      "./model-prompts.ts"
    ]
  }
}
